# ── Narrador (Ollama) ─────────────────────────────────────────────────────────
# Activar/desactivar generación narrativa con LLM (1 = activo, 0 = desactivado)
NARRATIVE_ENABLED=1

# URL base del servidor Ollama
OLLAMA_BASE_URL=http://localhost:11434

# Modelo a usar (debe estar disponible en tu instancia de Ollama)
# Para descargarlo: ollama pull llama3.2
OLLAMA_MODEL=llama3.2

# Timeout en segundos para llamadas al LLM
OLLAMA_TIMEOUT=120

# ── Reproducción / demografía ────────────────────────────────────────────────
# Vínculo mínimo entre dos agentes para reproducirse (0.0–1.0)
BOND_REPRO_MIN=0.55

# Probabilidad diaria de nacimiento por par elegible
PROB_REPRO_DIARIA=0.007

# Días de cooldown post-nacimiento por padre
REPRO_COOLDOWN_DIAS=180

# Umbral máximo de hambre/sed para poder reproducirse (0.0–1.0)
REPRO_NEEDS_MAX=0.45

# ── Zona Liminal ─────────────────────────────────────────────────────────────
# Host del servidor liminal. 'localhost' para servidor local, IP para remoto
LIMINAL_HOST=localhost

# ── Catástrofes ──────────────────────────────────────────────────────────────
# Factor de letalidad en catástrofes: 1.0 = comportamiento estándar
# <1.0 reduce muertes directas y amplifica trauma simbólico en supervivientes
LETHALITY_FACTOR=1.0

# ── Mitología ─────────────────────────────────────────────────────────────────
# Umbral de contexto para que nazca un proto-mito (menor = más proto-mitos)
MYTH_CONTEXT_THRESHOLD=0.25

# ── Ecuación Personal (Fase 1 — InterpretiveFilter) ──────────────────────────
# Cada agente interpreta el estímulo presente como respuesta afectiva escalar
# (Capa A) que modula su colapso conductual. Los slots simbólicos (causa, juicio
# moral, frame narrativo) nacen vacíos y solo se llenan con vocabulario que ya
# cristalizó en el colectivo. 0 = desactivado (default, reproducibilidad intacta).
# Activar a 1 para corridas A/B y medir el impacto en divergencia cultural.
INTERPRETIVE_FILTER_ENABLED=0

# ── Ecuación Personal (Fase 2 — MentalVault) ─────────────────────────────────
# Mini cerebro por agente: neuronas que se enlazan por la misma física de
# cristalización del campo colectivo, una escala más abajo, una vez por día.
# EXIGE INTERPRETIVE_FILTER_ENABLED=1 (consume PerceivedEvents); si el filtro está
# OFF, el vault se desactiva solo. 0 = desactivado (default).
MENTAL_VAULT_ENABLED=0

# ── Simulación ────────────────────────────────────────────────────────────────
# Cada cuántos días simulados guardar un checkpoint automático
CHECKPOINT_INTERVAL=10

# Cada cuántos días simulados recalcular las tribus (clustering social)
DAYS_UNTIL_CLUSTERING=30

# ── Preset experimental — emergencia cultural (Roadmap 7) ─────────────────────
# Descomenta el bloque completo y ajusta según necesidad:
# CHECKPOINT_INTERVAL=20
# DAYS_UNTIL_CLUSTERING=20
# BOND_REPRO_MIN=0.55
# PROB_REPRO_DIARIA=0.007
# REPRO_COOLDOWN_DIAS=180
# LETHALITY_FACTOR=0.5
# MYTH_CONTEXT_THRESHOLD=0.25
